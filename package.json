{
  "name": "jiuyijian",
  "version": "0.1.0",
  "private": true,
  "description": "离线优先的就诊交接单 PWA：把病历、化验单、处方整理成患者可核对、医生看得懂的交接单（未经临床专业审核，不提供诊断或用药建议）",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/666888yjc/jiuyijian.git"
  },
  "homepage": "https://github.com/666888yjc/jiuyijian#readme",
  "keywords": [
    "pwa",
    "offline-first",
    "patient-handoff",
    "medical-records",
    "privacy-first"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "node dev/local-app/e2e.mjs",
    "dev:api": "node dev/api-fixture/server.mjs 8000"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^4.10.38",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
